    "package:win": "npm run build && electron-packager . \"ASG Glass Lab\" --platform=win32 --arch=x64 --out=release --overwrite --asar --prune=true --icon=assets/icon.ico --ignore=^/release --ignore=^/scripts --ignore=^/electron/main.cjs --ignore=^/src --ignore=^/tests --ignore=^/test-results"
  },
  "keywords": [],
  "type": "module",
  "private": "true",
