{
  "name": "asg-glass-lab",
  "version": "0.0.0",
  "description": "",
  "main": "electron/preview.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lab": "node scripts/run-lab.mjs",
    "lab:direct": "electron electron/main.cjs --url http://127.0.0.1:5199",
