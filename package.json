    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "dompurify": "^3.3.0",
    "lit": "^3.3.3",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.3",
    "reka-ui": "^2.6.0",
    "tslib": "^2.9.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^27.0.0",
