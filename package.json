{
  "name": "agent-search-gateway-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop control surface for Agent Search Gateway",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
